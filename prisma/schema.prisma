generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum TaskStatus {
  todo
  in_progress
  review
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum OrgRole {
  org_admin
  member
}

// ─────────────────────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  memberships     OrgMember[]
  refreshTokens   RefreshToken[]
  taskAssignments TaskAssignment[]
  comments        Comment[]
  // Tasks created by this user
  createdTasks    Task[]           @relation("TaskCreator")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Organizations
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  members  OrgMember[]
  projects Project[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Org Members  (join table: users ↔ organizations)
// ─────────────────────────────────────────────────────────────────────────────

model OrgMember {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           OrgRole  @default(member)
  createdAt      DateTime @default(now()) @map("created_at")

  // FK decisions:
  //   user → RESTRICT  : cannot delete a user who is still in an org
  //   org  → CASCADE   : deleting an org removes all memberships
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  // Index: look up all members of an org (common query)
  @@index([organizationId])
  // Index: look up all orgs a user belongs to
  @@index([userId])
  @@map("org_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// Refresh Tokens
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")   // store hash, not raw token
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")   // null = active
  createdAt DateTime  @default(now()) @map("created_at")

  // FK: CASCADE — removing user clears their tokens
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index: look up active tokens for a user quickly
  @@index([userId])
  // Index: look up by token hash for validation
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?
  deletedAt      DateTime? @map("deleted_at") // ★ Soft delete bonus

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // FK: CASCADE — deleting org removes its projects
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  // Index: fetch all projects in an org (primary access pattern)
  @@index([organizationId])
  // Index: support soft-delete filter (WHERE deleted_at IS NULL)
  @@index([deletedAt])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(uuid())
  projectId   String       @map("project_id")
  creatorId   String       @map("creator_id")
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @map("due_date")
  deletedAt   DateTime?    @map("deleted_at") // ★ Soft delete bonus

  // ★ Full-text search: GIN index on tsvector of title + description
  // Generated column for FTS — we index it below
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // FK: CASCADE — deleting project removes its tasks
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // FK: RESTRICT — cannot delete user who created tasks
  creator User    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  assignments TaskAssignment[]
  comments    Comment[]

  // Index: fetch tasks by project (primary access pattern)
  @@index([projectId])
  // Index: filter by status
  @@index([status])
  // Index: filter by priority
  @@index([priority])
  // Index: filter by due date range
  @@index([dueDate])
  // Index: soft-delete filter
  @@index([deletedAt])
  @@map("tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Task Assignments  (join table: tasks ↔ users)
// ─────────────────────────────────────────────────────────────────────────────

model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  // FK: CASCADE — removing task removes its assignments
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // FK: RESTRICT — cannot delete user who has active assignments
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([taskId, userId]) // prevent duplicate assignments
  // Index: find all tasks assigned to a user
  @@index([userId])
  // Index: find all assignees for a task
  @@index([taskId])
  @@map("task_assignments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Comments
// ─────────────────────────────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // FK: CASCADE — removing task removes its comments
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // FK: RESTRICT — cannot delete user who authored comments
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // Index: fetch comments by task
  @@index([taskId])
  @@map("comments")
}
